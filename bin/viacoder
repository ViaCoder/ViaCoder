#!/usr/bin/env bash
set -euo pipefail

# Public ViaCoder command; keep the internal cc launcher and Claude runtime identity intact.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  BASE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$BASE/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
exec "$ROOT/bin/cc" "$@"
