#!/usr/bin/env bash
set -euo pipefail

# Public command. Keep the legacy implementation inside each immutable release
# so upgrades and rollback to pre-rename releases share the same launch contract.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  BASE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$BASE/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
exec "$ROOT/bin/cc" "$@"
