  "behaviorNotes": [
    "EM is emitted verbatim from chunk-x5pmvzy7.js and returned directly.",
    "Ik is emitted verbatim from chunk-52qbm57h.js; pe is the original var pe=500 declaration.",
    "The default cap is 32000 and the fourth argument supplies deterministic jitter in tests.",
