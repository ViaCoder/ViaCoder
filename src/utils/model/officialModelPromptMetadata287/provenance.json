          "sha256": "91ac5fca6d3c182e46b78f2fbfcc7b837f30cc75112ddc9e13cb7153f31c7c97",
          "source": "function v_n(e){return e.knowledgeCutoff?`Assistant knowledge cutoff is ${e.knowledgeCutoff}.`:null}",
