          "source": "function Wp(e){if(He()===\"foundry\")return;let n=Be(e,{identity:!0}),r=BI.get(n);if(r!==void 0)return r;let s=xa(n);if(!s)return;return e.toLowerCase().includes(\"[1m]\")&&UI.has(n)?`${s.display_name} (1M context)`:s.display_name}",
