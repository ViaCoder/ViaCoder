          "sha256": "801166377db357654ac440062c0829bb8b6630a2f7b9edbbfc3b111be74d214e",
          "source": "function __n(e){return e.marketingName?`You are powered by the model named ${e.marketingName}. The exact model ID is ${e.modelId}.`:`You are powered by the model ${e.modelId}.`}",
          "variable": false
        },
        {
