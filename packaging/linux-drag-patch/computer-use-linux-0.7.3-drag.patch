+/// Borrow the same absolute pointer until release has completed. Normal
+/// errors use explicit release so its error is returned; Drop covers unwinding.
+struct DragButtonRelease<'a> {
+    pointer: &'a mut AbsPointer,
+    code: u16,
+    armed: bool,
+}
+
+impl DragButtonRelease<'_> {
+    fn release(&mut self) -> Result<()> {
+        // One release attempt even on failure, not an implicit input retry.
+        self.armed = false;
+        self.pointer.device
